DATABASE_URL=sqlite:///./runtime/prosper.sqlite3
AUTH_REQUIRED=false
ACCESS_PASSWORD=
SESSION_SECRET=
SESSION_TTL_SECONDS=86400
AUTH_COOKIE_SECURE=false

# Optional model provider configuration. The simulator and deterministic tests work without it.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-reasoner

# Optional tracing configuration.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Optional Supabase configuration for property media storage.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=property-media

# The backend only needs these when the WhatsApp bridge is running.
BRIDGE_BASE_URL=http://127.0.0.1:8788
WHATSAPP_PA_BRIDGE_TOKEN=
WHATSAPP_PA_BRIDGE_HOST=127.0.0.1
WHATSAPP_PA_BRIDGE_PORT=8788
WHATSAPP_PA_TRIAGE_BURST_WAIT_MS=3000
WHATSAPP_PA_ACTIVE_BURST_WAIT_MS=3000
WHATSAPP_PA_MAX_BACKFILL_MS=300000
WHATSAPP_HISTORY_SYNC_ONBOARDING=false
