DATABASE_URL=sqlite:///./runtime/prosper.sqlite3
AUTH_REQUIRED=false
ACCESS_PASSWORD=
SESSION_SECRET=
SESSION_TTL_SECONDS=86400
AUTH_COOKIE_SECURE=false

# DeepSeek is required for the live happy path. The app can start without this
# key, and deterministic tests use a fake DeepSeek-compatible endpoint.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-reasoner

# The backend only needs these when the optional experimental WhatsApp bridge is running.
PROSPER_BRIDGE_BASE_URL=http://127.0.0.1:8788
# Required for bridge callbacks and backend-to-bridge operations.
PROSPER_BRIDGE_TOKEN=
PROSPER_BRIDGE_HOST=127.0.0.1
PROSPER_BRIDGE_PORT=8788
PROSPER_TRIAGE_BURST_WAIT_MS=3000
PROSPER_ACTIVE_BURST_WAIT_MS=3000
PROSPER_MAX_BACKFILL_MS=300000
WHATSAPP_HISTORY_SYNC_ONBOARDING=false
